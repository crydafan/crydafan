---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="crydafan">
  <div class="flex min-h-screen flex-col font-mono">
    <main
      class="flex flex-1 flex-col items-center justify-center px-6 text-center"
    >
      <h1 class="mb-4 text-4xl font-bold sm:text-5xl">
        Hello, World! I&apos;m Leonardo
      </h1>
      <p class="text-xl text-neutral-700">
        I&apos;m a software engineer and a huge Daft Punk fan 👾.
      </p>
      <div id="poem" class="mt-20 text-xl text-neutral-700"></div>
    </main>

    <footer class="p-8 text-center">
      <div class="flex items-center justify-center gap-8">
        <a
          href="https://github.com/crydafan"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-neutral-700 transition-colors hover:text-black hover:underline"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-5 w-5 fill-current"
          >
            <path
              d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.5 0-.25-.01-.92-.01-1.8-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.54 1.05 1.54 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.13.63-1.39-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.84a9.3 9.3 0 0 1 2.5.35c1.9-1.33 2.74-1.05 2.74-1.05.55 1.4.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.8-4.58 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .28.18.61.69.5A10.26 10.26 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"
            ></path>
          </svg>
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/crydafan"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-neutral-700 transition-colors hover:text-black hover:underline"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-5 w-5 fill-current"
          >
            <path
              d="M19 3A2 2 0 0 1 21 5v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14ZM8.34 18.34v-8h-2.66v8h2.66Zm-1.33-9.1a1.54 1.54 0 1 0 0-3.08 1.54 1.54 0 0 0 0 3.08Zm11.33 9.1v-4.37c0-2.34-1.25-3.43-2.92-3.43-1.35 0-1.95.74-2.29 1.26v-1.08h-2.67c.04.72 0 7.62 0 7.62h2.67v-4.26c0-.23.02-.45.08-.61.18-.45.58-.92 1.26-.92.89 0 1.25.68 1.25 1.67v4.12h2.62Z"
            ></path>
          </svg>
          LinkedIn
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
